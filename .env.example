# === Optional shared-library override ===

# Usually only needed for a custom Windows install; Linux/macOS and the
# standard Windows MSI path are detected automatically. The library and
# Python interpreter must have matching architectures.
# Windows:  C:\Program Files\eSpeak NG\libespeak-ng.dll
# macOS:    /opt/homebrew/lib/libespeak-ng.dylib
# Linux:    /usr/lib/x86_64-linux-gnu/libespeak-ng.so  (usually auto-detected)
# PHONEMIZER_ESPEAK_LIBRARY=C:\custom\path\libespeak-ng.dll

# === Optional ===

# HuggingFace Hub (for private datasets or higher rate limits)
HF_TOKEN=your_huggingface_token_here

# LLM API keys (only needed for LLM generation strategy)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Local model path (only needed for local generation strategy)
LOCAL_MODEL_PATH=path/to/your/local/model
